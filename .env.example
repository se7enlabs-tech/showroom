# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required to send emails via Resend
RESEND_API_KEY="your_resend_api_key_here"

# RESEND_TO_EMAIL: The recipient email.
RESEND_TO_EMAIL="se7enlabs.tech@gmail.com"

# CAL_API_KEY: Cal.com API key for scheduling integration
CAL_API_KEY="your_cal_api_key_here"

# CAL_EVENT_LINK: Cal.com discovery booking link
CAL_EVENT_LINK="https://cal.com/se7enlabs/discovery"

# MAKE_WEBHOOK_URL: Webhook URL created in Make.com custom webhook trigger module
MAKE_WEBHOOK_URL="your_make_webhook_url_here"

# MAKE_API_KEY: Optional API key configured in Make.com custom webhook security (sent via x-make-apikey header)
MAKE_API_KEY="your_make_api_key_here"
